<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.vinabeef</groupId>
    <artifactId>vinabeef-reporting</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>VinaBeef Reporting Subsystem (Microkernel)</name>

    <properties>
        <java.version>17</java.version>
        <poi.version>5.3.0</poi.version>
        <openpdf.version>2.0.3</openpdf.version>
    </properties>

    <modules>
        <module>reporting-kernel</module>
        <module>plugins</module>
        <module>reporting-infrastructure</module>
        <module>reporting-app</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.vinabeef</groupId>
                <artifactId>reporting-kernel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.vinabeef</groupId>
                <artifactId>reporting-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.vinabeef</groupId>
                <artifactId>plugin-report-definitions</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.vinabeef</groupId>
                <artifactId>plugin-exporter-excel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.vinabeef</groupId>
                <artifactId>plugin-exporter-pdf</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.vinabeef</groupId>
                <artifactId>plugin-integration-nadcs</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
